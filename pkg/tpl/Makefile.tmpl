APP_NAME := {{ .ProjectName}}
VERSION ?= 0.0.1
BUILD_DATE := $(shell date -u +'%Y-%m-%dT%H:%M:%SZ')
GIT_COMMIT := $(shell git rev-parse HEAD 2>/dev/null || echo unknown)
GIT_TAG := $(shell git describe --exact-match --tags HEAD 2>/dev/null || true)
GIT_TREE_STATE := $(shell test -z "$$(git status --porcelain 2>/dev/null)" && echo clean || echo dirty)
GOOS ?= $(shell go env GOOS)
GOARCH ?= $(shell go env GOARCH)
CGO_ENABLED ?= 0

LDFLAGS := -s -w \
	-X {{ .ModulePath}}/pkg/util.version=$(VERSION) \
	-X {{ .ModulePath}}/pkg/util.buildDate=$(BUILD_DATE) \
	-X {{ .ModulePath}}/pkg/util.gitCommit=$(GIT_COMMIT) \
	-X {{ .ModulePath}}/pkg/util.gitTag=$(GIT_TAG) \
	-X {{ .ModulePath}}/pkg/util.gitTreeState=$(GIT_TREE_STATE)

.PHONY: build test vet fmt clean docker

build:
	mkdir -p bin
	CGO_ENABLED=$(CGO_ENABLED) GOOS=$(GOOS) GOARCH=$(GOARCH) go build -trimpath -ldflags '$(LDFLAGS)' -o bin/$(APP_NAME) .

test:
	go test ./...

vet:
	go vet ./...

fmt:
	gofmt -w $$(find . -name '*.go' -type f)

clean:
	rm -rf bin

docker:
	docker build -t $(APP_NAME):$(VERSION) .
