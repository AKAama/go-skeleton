FROM golang:1.20-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/{{ .ProjectName}} .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S app \
    && adduser -S -G app app
WORKDIR /app
COPY --from=builder /out/{{ .ProjectName}} ./{{ .ProjectName}}
COPY etc ./etc
USER app
EXPOSE 3000
ENTRYPOINT ["./{{ .ProjectName}}"]
CMD ["--config", "etc/config.yaml"]
